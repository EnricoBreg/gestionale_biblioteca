<div id="<%= dom_id book %>" class="container page gap-6">
  
  <div class="page-header items-end">
    <div>
      <nav class="breadcrumb" aria-label="Percorso">
        <%= link_to "Libri", books_url %>
        <span><%= book.title %></span>
      </nav>
      <h1><%= book.title %></h1>
      <p class="subtitle text-lg"><%= book.author %></p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= button_to "Elimina", book, class: "danger", method: :delete, data: { turbo_confirm: "Sei sicuro di voler cancellare il libro?" } %>
      <%= link_to "Modifica", edit_book_path(book), role: "button", class: "outline" %>
    </div>
  </div>

  <dl class="details card">
    <div>
      <dt><%= Book.human_attribute_name(:publication_year) %></dt>
      <dd><%= book.publication_year %></dd>
    </div>
    <div>
      <dt><%= Book.human_attribute_name(:isbn) %></dt>
      <dd class="mono"><%= book.isbn %></dd>
    </div>
    <div>
      <dt><%= Book.human_attribute_name(:category) %></dt>
      <dd><%= book.category %></dd>
    </div>
    <div>
      <dt>Copie disponibili</dt>
      <dd><%= book.book_copies.size %> su <%= book.book_copies.size %></dd>
    </div>
  </dl>

  <section class="flex flex-col gap-3">
    <h2>Copie</h2>
    
    <div class="table-wrap">
      <% if book.book_copies.empty? %>
        <p>Nessuna copia registrata per questo libro.</p>
      <% else %> 
        <table>
          <thead>
            <tr>
              <th scope="col">Codice inventario</th>
              <th scope="col">Collocazione</th>
              <th scope="col">Stato</th>
              <th scope="col">Prestito attuale</th>
              <th scope="col"><span class="sr-only">Azioni</span></th>
            </tr>
          </thead>
          <tbody>
            <% book.book_copies.each do |book_copy| %>
              <tr>
                <td class="mono"><%= book_copy.inventory_code %></td>
                <td><%= book_copy.location %></td>
                <% if book_copy.current_loan %>
                  <td><span class="badge">In prestito</span></td>
                  <td><%= book_copy.current_loan.member.full_name %> - scade il <%= l(book_copy.current_loan.due_on) %></td>
                <% else %>
                  <td><span class="badge info">Disponibile</span></td>
                  <td>—</td>
                <% end %>
                <td class="cell-actions">
                  <%= link_to "Modifica", edit_book_copy_path(book_copy) %>
                  <%= link_to "Elimina", book_copy, class: "text-danger", 
                              data: { turbo_method: :delete, 
                                      turbo_confirm: "Sei sicuro di voler eliminare la copia?" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </section>

  <section class="panel flex flex-col gap-4">
    <h3>Aggiungi una copia</h3>

    <%= form_with model: [ book, @book_copy || BookCopy.new ], method: :post do |form| %>
      <% if form.object.errors.any? %>
        <div class="alert error mb-2" role="alert">
          <p>Impossibile salvare la nuova copia:</p>
          <ul>
            <% form.object.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="filters">
        <label class="grow-1">
          <%= BookCopy.human_attribute_name(:inventory_code) %>
          <%= form.text_field :inventory_code, placeholder: "INV-001-D" %>
        </label>

        <label class="grow-3">
          <%= BookCopy.human_attribute_name(:location) %>
          <%= form.text_field :location, placeholder: "Sala A · Scaffale 1" %>
        </label>

        <%= form.submit "Aggiungi copia" %>
      </div>
      
    <% end %>
  </section>

</div>

