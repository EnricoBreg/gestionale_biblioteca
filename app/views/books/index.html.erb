<% content_for :title, "Libri" %>

<div class="page-header">
  <h1>Libri</h1>
  <%= link_to "Nuovo libro", new_book_path, role: "button" %>
</div>

<%= form_with url: books_url, method: :get, class: "filters", role: "search" do |form| %>
  <label class="grow-3">
    <%= Book.human_attribute_name(:title) %>
    <%= form.search_field :title, value: params[:title], placeholder: Book.human_attribute_name(:title) %>
  </label>

  <label class="grow-1">
    <%= Book.human_attribute_name(:author) %>
    <%= form.search_field :author, value: params[:author], placeholder: Book.human_attribute_name(:author) %>
  </label>

  <label class="grow-1">
    <%= Book.human_attribute_name(:isbn) %>
    <%= form.search_field :isbn, value: params[:isbn], placeholder: Book.human_attribute_name(:isbn) %>
  </label>

  <label class="grow-1">
    <%= Book.human_attribute_name(:category) %>
    <%= form.select :category, Book.categories, { include_blank: "Tutte le categorie", selected: params[:category] } %>
  </label>
  
  <div class="flex gap-2">
    <%= form.button "Filtra", class: "outline", type: :submit %>
    <%= link_to "Azzera", books_path, class: "secondary", role: :button %>
  </div>
<% end %>

<div id="books" class="table-wrap">
  <% if @books.empty? %>
    <p>Nessun libro trovato.</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th scope="col">Titolo</th>
          <th scope="col">Autore</th>
          <th scope="col">Anno</th>
          <th scope="col">ISBN</th>
          <th scope="col">Categoria</th>
          <th scope="col">Copie disponibili</th>
          <th scope="col"><span class="sr-only">Azioni</span></th>
        </tr>
      </thead>
      <tbody>
        <% @books.each do |book| %>
          <tr>
            <td><%= link_to book.title, book_path(book), class: "font-medium" %></td>
            <td><%= book.author %></td>
            <td><%= book.publication_year %></td>
            <td class="mono"><%= book.isbn %></td>
            <td><%= book.category %></td>
            <td class="nowrap"><strong><%= book.copies_count %></strong> su <%= book.copies_count %></td>
            <td class="cell-actions"><%= link_to "Vedi libro", book %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
