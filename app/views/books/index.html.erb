<% content_for :title, "Libri" %>

<div class="page-header">
  <h1>Libri</h1>
  <%= link_to "Nuovo libro", new_book_path, role: "button" %>
</div>

<%= form_with url: books_url, method: :get, class: "filters", role: "search" do |form| %>
  <label class="grow-3">
    <%= Book.human_attribute_name(:title) %>
    <%= form.search_field :title, value: params[:title], placeholder: Book.human_attribute_name(:title) %>
  </label>
  <label class="grow-1">
    <%= Book.human_attribute_name(:category) %>
    <%= form.select :category, Book.categories, { include_blank: "Tutte le categorie", selected: params[:category] } %>
  </label>
  <%= form.button "Filtra", class: "outline" %>
<% end %>

<div id="books" class="table-wrap">
  <% if @books.empty? %>
    <p>Nessun libro trovato.</p>
  <% else %>
    <table>
      <thead>
        <tr>
          <th scope="col">Titolo</th>
          <th scope="col">Autore</th>
          <th scope="col">Anno</th>
          <th scope="col">ISBN</th>
          <th scope="col">Categoria</th>
          <th scope="col">Copie disponibili</th>
          <th scope="col"><span class="sr-only">Azioni</span></th>
        </tr>
      </thead>
      <tbody>
        <% @books.each do |book| %>
          <tr>
            <td><a class="font-medium"><%= book.title %></a></td>
            <td><%= book.author %></td>
            <td><%= book.publication_year %></td>
            <td class="mono"><%= book.isbn %></td>
            <td><%= book.category %></td>
            <td class="nowrap"><%= book.book_copies.size %></td>
            <td class="cell-actions"><%= link_to "Vedi libro", book %></td>
          </td>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
